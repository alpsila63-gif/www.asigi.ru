name: Deploy to Server

on:
  push:
    branches: [main]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Deploy via rsync
        uses: burnett01/rsync-deployments@7.0.1
        with:
          switches: -avz --delete --chmod=Du=rwx,Dgo=rx,Fu=rw,Fgo=r
          path: public_html/
          remote_path: /var/www/agisi.ru/public_html/
          remote_host: 166.1.62.19
          remote_user: root
          remote_key: ${{ secrets.SSH_KEY }}
          remote_port: 22
